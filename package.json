{
  "name": "mindbot-genius",
  "version": "1.0.0",
  "description": "Mindbot Genius - AI Chat by Binary Global Network",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-updater": "^6.3.9",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.binaryglobalnetwork.mindbotgenius",
    "productName": "Mindbot Genius",
    "copyright": "© 2026 Binary Global Network",
    "icon": "public/logo.ico",
    "artifactName": "Mindbot-Genius-Setup.exe",
    "publish": {
      "provider": "generic",
      "url": "https://github.com/arzikivirend-lucu/Mindbot-genius-Ai/releases/download/latest-exe/"
    },
    "files": [
      "main.js",
      "server.js",
      "package.json",
      "public/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/logo.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/logo.ico",
      "installerHeaderIcon": "public/logo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mindbot Genius",
      "uninstallerIcon": "public/logo.ico"
    }
  },
  "author": "Binary Global Network"
}
